generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          String    @default("STAFF") // ADMIN, TECHNICIAN, STAFF
  permissions   String    @default("") // Comma-separated permissions  
  department    String?   // Khoa phòng phụ trách (dành cho Kỹ thuật viên)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          Log[]
  maintenances  Maintenance[]
  usageLogs     UsageLog[]
}

model Equipment {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique // e.g. KHOA-YYYYMMDD-STT
  department    String
  status        String    @default("WORKING") // WORKING, WARNING, BROKEN
  purchaseDate  DateTime
  riskScore     String    @default("LOW") // LOW, MEDIUM, HIGH
  model         String?
  serialNumber  String?
  brand         String?
  origin        String?
  contactInfo   String?
  usageNotes    String?
  qcTechnician  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          Log[]
  maintenances  Maintenance[]
  usageLogs     UsageLog[]
}

model Log {
  id          String    @id @default(cuid())
  equipmentId String
  userId      String
  status      String    // Trạng thái được nhân viên cập nhật
  reporterName  String?   // Tên người báo cáo nhập từ điện thoại
  note        String?
  imageUrl   String?
  createdAt   DateTime  @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([equipmentId])
  @@index([userId])
}

model Maintenance {
  id            String    @id @default(cuid())
  equipmentId   String
  technicianId  String
  description   String
  cost          Float?
  status        String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  date          DateTime
  isNotified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  technician    User      @relation(fields: [technicianId], references: [id])

  @@index([equipmentId])
  @@index([technicianId])
}

model UsageLog {
  id            String    @id @default(cuid())
  equipmentId   String
  userId        String?
  userName      String
  purpose       String
  startTime     DateTime  @default(now())
  endTime       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])

  @@index([equipmentId])
  @@index([userId])
}
