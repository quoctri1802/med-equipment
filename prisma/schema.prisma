generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  role          String    @default("STAFF") // ADMIN, TECHNICIAN, STAFF
  permissions   String    @default("") // Comma-separated permissions  
  department    String?   // Khoa phòng phụ trách (dành cho Kỹ thuật viên)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          Log[]
  maintenances  Maintenance[]
  usageLogs     UsageLog[]
  qcs           QualityControl[]
  sampleRuns    SampleRun[]
}

model Equipment {
  id            String    @id @default(cuid())
  name          String
  code          String    @unique // e.g. KHOA-YYYYMMDD-STT
  department    String
  status        String    @default("WORKING") // WORKING, WARNING, BROKEN
  purchaseDate  DateTime
  riskScore     String    @default("LOW") // LOW, MEDIUM, HIGH
  model         String?
  serialNumber  String?
  brand         String?
  origin        String?
  contactInfo   String?
  usageNotes    String?
  qcTechnician  String?
  testGroup     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          Log[]
  maintenances  Maintenance[]
  usageLogs     UsageLog[]
  totalSamples  Int           @default(0)
  calibrations  Calibration[]
  qcs           QualityControl[]
  sampleRuns    SampleRun[]
  reagents      Reagent[]
}

model Log {
  id          String    @id @default(cuid())
  equipmentId String
  userId      String
  status      String    // Trạng thái được nhân viên cập nhật
  reporterName  String?   // Tên người báo cáo nhập từ điện thoại
  note        String?
  imageUrl   String?
  createdAt   DateTime  @default(now())

  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([equipmentId])
  @@index([userId])
}

model Maintenance {
  id            String    @id @default(cuid())
  equipmentId   String
  technicianId  String
  description   String
  cost          Float?
  status        String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  date          DateTime
  isNotified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  technician    User      @relation(fields: [technicianId], references: [id])

  @@index([equipmentId])
  @@index([technicianId])
}

model UsageLog {
  id            String    @id @default(cuid())
  equipmentId   String
  userId        String?
  userName      String
  purpose       String
  startTime     DateTime  @default(now())
  endTime       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  user          User?     @relation(fields: [userId], references: [id])

  @@index([equipmentId])
  @@index([userId])
}

model EquipmentGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}


model Calibration {
  id             String    @id @default(cuid())
  equipmentId    String
  date           DateTime  // Ngày hiệu chuẩn
  expireDate     DateTime  // Ngày hết hạn hiệu chuẩn (thường sau 1 năm)
  organization   String    // Đơn vị thực hiện hiệu chuẩn
  certificateUrl String?   // Đường dẫn tệp PDF chứng nhận
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  equipment      Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  @@index([equipmentId])
}

model QualityControl {
  id            String    @id @default(cuid())
  equipmentId   String
  userId        String
  type          String    // "IQC" hoặc "EQC"
  controlName   String    // Tên mẫu chuẩn (Ví dụ: Level 1, Level 2)
  lotNumber     String    // Số lô (Lot)
  parameterName String    // Chỉ số xét nghiệm (Ví dụ: Glucose, WBC, RBC, PLT)
  measuredValue Float     // Giá trị đo thực tế của KTV
  targetValue   Float     // Giá trị trung bình nhà sản xuất (Mean)
  sdValue       Float     // Độ lệch chuẩn nhà sản xuất (SD)
  resultStatus  String    // Trạng thái kiểm định: PASS, WARNING, FAIL
  runDate       DateTime  @default(now())
  notes         String?

  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])
  @@index([equipmentId])
  @@index([userId])
}

model SampleRun {
  id            String    @id @default(cuid())
  equipmentId   String
  userId        String
  runDate       DateTime  @default(now())
  sampleCount   Int       // Số mẫu chạy trong ngày
  notes         String?

  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id])
  @@index([equipmentId])
  @@index([userId])
}


model Reagent {
  id                    String    @id @default(cuid())
  name                  String
  code                  String    // Mã hóa chất/SKU
  lotNumber             String    // Số lô
  expiryDate            DateTime  // Hạn sử dụng
  volume                Float     // Thể tích / Số lượng hiện tại trong kho
  unit                  String    // Đơn vị (ml, test, hộp)
  minSafetyVolume       Float     // Ngưỡng báo động tồn kho tối thiểu
  consumptionPerSample  Float     @default(0) // Định mức tiêu hao trên 1 mẫu
  equipmentId           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  equipment             Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  @@index([equipmentId])
}
